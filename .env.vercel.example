# ─────────────────────────────────────────────────────────────
# Vercel → Project Settings → Environment Variables
# 只填在 Vercel，永远不要提交进仓库，也不要加 VITE_ 前缀。
# ─────────────────────────────────────────────────────────────

# 【必需】后台登录密码。不填则云端写入能力关闭，站点回退为纯静态 + 本地界面锁。
ADMIN_PASSWORD=please-change-me

# 【推荐】会话签名密钥，任意长随机字符串。不填时用 ADMIN_PASSWORD 派生。
AUTH_SECRET=random-long-string

# 【推荐】服务端 GitHub 写入凭据：fine-grained PAT，只需目标仓库 Contents: read & write。
# 有了它，站点配置 / 草稿 / AI 摘要会存到仓库的 content/data/*.json。
GITHUB_TOKEN=github_pat_xxxxxxxx

# GITHUB_REPO 一般可省略：Vercel 会自动注入 VERCEL_GIT_REPO_OWNER / SLUG。
# 只有仓库与部署项目不一致时才需要显式指定。
# GITHUB_REPO=username/repo-name
# GITHUB_BRANCH=main

# 若博客源码放在仓库子目录（共存模式），发布文章时写到这里。
# POSTS_DIR=blog/src/content/posts

# 【可选】Upstash / Vercel KV：高频浏览量与点赞计数。不填则用仓库 JSON 存储。
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxx

# 【可选】AI 摘要：任何 OpenAI 兼容接口（OpenAI / 混元 / DeepSeek / 自建代理）。
# 不填时自动降级为本地提取式摘要，功能仍可用。
# AI_API_KEY=sk-xxxxxxxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# 【可选】编译期默认值（这些是 VITE_ 前缀，会打进前端产物，不能放密钥）
# VITE_TWIKOO_ENV_ID=your-env-id
# VITE_GITHUB_OWNER=username
# VITE_GITHUB_REPO=repo-name
